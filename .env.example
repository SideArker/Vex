# ==============================================================================
# Vex & Jev Configuration
# ==============================================================================

# API Provider Selection ('typesafe' [default] or 'openrouter')
# JEV_PROVIDER=typesafe

# Option 1: Native TypeSafe AI Direct (Recommended - $0.042/1M tokens, 70-500ms)
# Get your API key at: https://console.typesafe.ai
TYPESAFE_API_KEY=ts-live-...
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# Option 2: OpenRouter Decisions API
# Get your API key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=typesafe/jev-1.13
# OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha/decisions

# Optional Engine Overrides
# JEV_EXECUTABLE=jev
# JEV_TIMEOUT_MS=45000
# VEX_STATS_PATH=~/.agents/jev_stats.json
