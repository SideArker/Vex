{
  "name": "@sidearker/vex-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "TypeScript Jev decision engine, CLI, and Vex MCP server",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SideArker/Vex.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jev": "dist/cli/jev.js",
    "vex": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "integrations/codex"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && vitest run",
    "check": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
